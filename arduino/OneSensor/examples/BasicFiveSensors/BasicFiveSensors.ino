/**
 * BasicFiveSensors.ino — OneSensor Full 12-Channel Example Sketch
 *
 * Demonstrates reading all 12 virtual sensor channels from the OneSensor
 * library. Each channel is decoded from a PWM or DAC signal generated by
 * the connected ESP32.
 *
 * DEFAULT WIRING (matches ArduinoChannelConfig.h):
 *   ESP32 GPIO25 → Arduino A0   (Temperature — DAC)  [0–50 °C]
 *   ESP32 GPIO26 → Arduino A1   (Humidity    — DAC)  [0–100 %]
 *   ESP32 GPIO18 → Arduino D4   (Gas         — PWM)  [0–1000 ppm]
 *   ESP32 GPIO19 → Arduino D5   (Light       — PWM)  [0–1000 lux]
 *   ESP32 GPIO21 → Arduino D6   (Soil Moist. — PWM)  [0–100 %]
 *   ESP32 GPIO22 → Arduino D7   (Motion X    — PWM)  [-2 to +2 g]
 *   ESP32 GPIO23 → Arduino D8   (Motion Y    — PWM)  [-2 to +2 g]
 *   ESP32 GPIO27 → Arduino D9   (Motion Z    — PWM)  [-2 to +2 g]
 *   ESP32 GPIO32 → Arduino D10  (Proximity   — PWM)  [2–400 cm]
 *   ESP32 GPIO33 → Arduino D11  (Sound       — PWM)  [30–120 dB]
 *   ESP32 GPIO14 → Arduino D12  (UV Index    — PWM)  [0–11 idx]
 *   ESP32 GPIO12 → Arduino D13  (CO2         — PWM)  [400–5000 ppm]
 *   ESP32 GND    → Arduino GND  (Common ground — MANDATORY)
 *
 * DYNAMIC CONFIG (optional — call before or after begin()):
 *   sensor.setRange(SensorType::TEMPERATURE, -10.0, 85.0);  // expand temp range
 *   sensor.saveConfig();                                      // persist to EEPROM
 *   sensor.resetConfig();                                     // restore defaults
 *
 * SERIAL PROVISIONING:
 *   Send a JSON string over Serial to reconfigure channels at runtime:
 *   {"channels":{"temperature":{"pin":14,"signal":"dac","min":0,"max":100}}}
 *   The library responds with {"status":"saved"} or {"status":"error",...}
 */

#include <OneSensor.h>

OneSensor sensor;

void setup() {
    Serial.begin(115200);
    delay(500);

    Serial.println(F("\n============================================"));
    Serial.println(F("  OneSensor v2 — 12-Channel Arduino Example"));
    Serial.println(F("============================================"));

    // Initialize all 12 channels.
    // Loads config from EEPROM if a saved config exists, otherwise uses
    // the compiled defaults from ARDUINO_CHANNEL_TABLE in ArduinoChannelConfig.h.
    sensor.begin();

    // Optional: override a range dynamically at startup
    // sensor.setRange(SensorType::TEMPERATURE, -10.0f, 85.0f);

    Serial.println(F("OneSensor ready. Reading all 12 channels...\n"));
}

void loop() {
    // Step 1: Update PWM/DAC measurements for all active channels.
    // Must be called every loop() — internally runs pulseIn() for PWM channels.
    sensor.update();

    // Step 2: Read all 12 decoded logical sensor values.
    float temp    = sensor.readTemperature();    // °C
    float humid   = sensor.readHumidity();       // %
    float gas     = sensor.readGas();            // ppm
    float light   = sensor.readLight();          // lux
    float soil    = sensor.readSoilMoisture();   // %
    float motionX = sensor.readMotionX();        // g
    float motionY = sensor.readMotionY();        // g
    float motionZ = sensor.readMotionZ();        // g
    float prox    = sensor.readProximity();      // cm
    float sound   = sensor.readSound();          // dB
    float uv      = sensor.readUV();             // UV index
    float co2     = sensor.readCO2();            // ppm

    // Step 3: Print all values.
    Serial.println(F("--- Sensor Readings ---"));
    Serial.print(F("Temperature : ")); Serial.print(temp,    2); Serial.println(F(" °C"));
    Serial.print(F("Humidity    : ")); Serial.print(humid,   2); Serial.println(F(" %"));
    Serial.print(F("Gas         : ")); Serial.print(gas,     1); Serial.println(F(" ppm"));
    Serial.print(F("Light       : ")); Serial.print(light,   1); Serial.println(F(" lux"));
    Serial.print(F("Soil Moist. : ")); Serial.print(soil,    2); Serial.println(F(" %"));
    Serial.print(F("Motion X    : ")); Serial.print(motionX, 3); Serial.println(F(" g"));
    Serial.print(F("Motion Y    : ")); Serial.print(motionY, 3); Serial.println(F(" g"));
    Serial.print(F("Motion Z    : ")); Serial.print(motionZ, 3); Serial.println(F(" g"));
    Serial.print(F("Proximity   : ")); Serial.print(prox,    1); Serial.println(F(" cm"));
    Serial.print(F("Sound       : ")); Serial.print(sound,   1); Serial.println(F(" dB"));
    Serial.print(F("UV Index    : ")); Serial.print(uv,      2); Serial.println(F(""));
    Serial.print(F("CO2         : ")); Serial.print(co2,     0); Serial.println(F(" ppm"));
    Serial.println(F("----------------------"));

    delay(500);
}
